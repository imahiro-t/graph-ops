# Serve the certificate generated by gen-certs.sh (its SAN names localhost
# and 127.0.0.1) instead of MySQL's auto-generated one, so all three GraphOps
# TLS modes can be tried. Plaintext is still accepted so "disabled" works too.
[mysqld]
ssl_ca=/etc/mysql/certs/ca.pem
ssl_cert=/etc/mysql/certs/server-cert.pem
ssl_key=/etc/mysql/certs/server-key.pem
require_secure_transport=OFF
