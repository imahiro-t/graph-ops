{
  "name": "@graph-ops/web",
  "version": "0.11.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/check-local-deps.js",
    "dev": "vite --port 3000",
    "prebuild": "node ../../scripts/check-local-deps.js",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "prelint": "node ../../scripts/check-local-deps.js",
    "lint": "eslint src vite.config.ts vitest.config.ts --max-warnings 0",
    "pretest": "node ../../scripts/check-local-deps.js",
    "test": "vitest run",
    "pretest:watch": "node ../../scripts/check-local-deps.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
